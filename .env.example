# ==============================================================================
# TTscope — Konfiguracja Środowiska (Wersja Lokalna i Produkcyjna)
# ==============================================================================

# Baza danych
# Jeśli DATABASE_URL nie jest podany, TTscope automatycznie korzysta z wbudowanej,
# szybkiej bazy lokalnej SQLite w pliku data/ttscope.db (zero konfiguracji, 100% lokalnie).
DATABASE_URL=
# Opcjonalnie dla Docker Compose:
# DATABASE_URL=postgresql://ttscope:ttscope_password_local_dev@localhost:5432/ttscope

# Supabase (do późniejszego wdrożenia na Vercel/Supabase)
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Gemini API (Warstwa Analityczna i Kontrolowane Wnioskowanie)
# Jeśli klucz nie jest skonfigurowany, system działa normalnie w trybie bez AI,
# raportując uczciwy status "analiza AI niedostępna".
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GEMINI_FAST_MODEL=gemini-2.5-flash
GEMINI_REASONING_MODEL=gemini-2.5-pro
GEMINI_MAX_OUTPUT_TOKENS=4096
GEMINI_TEMPERATURE=0.1
GEMINI_ENABLED=true

# Konektory mediów społecznościowych (opcjonalne klucze API)
# W przypadku braku klucza konektory pokazują prawdziwy status konfiguracji
TWITTER_BEARER_TOKEN=
FACEBOOK_GRAPH_TOKEN=
YOUTUBE_API_KEY=
LINKEDIN_CLIENT_SECRET=

# Aplikacja
NEXT_PUBLIC_APP_URL=http://localhost:3000
NODE_ENV=development
